# Copy to .env.local (or set in the hosting dashboard, e.g. Vercel → Settings → Environment Variables).

# Public site URL, used for SEO metadata and canonical links.
NEXT_PUBLIC_SITE_URL=https://sathyaenterprises-nine.vercel.app

# Optional tags. Each loads ONLY after the visitor allows its category in the cookie banner,
# and is stopped (its cookies deleted) if they withdraw. Leave empty to not use that tag at all.
# Google Analytics 4 measurement ID → "Analytics" cookies
NEXT_PUBLIC_GA_ID=
# Meta (Facebook) Pixel ID → "Marketing" cookies
NEXT_PUBLIC_META_PIXEL_ID=
